# Use 5001+ on macOS: port 5000 is used by AirPlay Receiver and returns 403 for HTTP
PORT=5001
MONGODB_URI=mongodb://localhost:27017/dr_indu_child_care
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# Optional: debug logging (LOG_LEVEL=debug|info|warn|error; DEBUG=app,mongo,http for namespaces)
# LOG_LEVEL=debug
# DEBUG=*
